+// co-op: a copy engine for the co-op module (its partner's rollback snapshots, module/partner.c),
+// at EXP2 + 0x100 (0x1F802100), where nothing is. Words: +0 destination, +4 source, +8 length in
+// bytes (whole words); writing +0xC runs it (1: copy, 2: exchange the two). Reading +0xC gives
+// 'COPY', so the module knows it's there (elsewhere it reads all ones and copies itself).
+static constexpr uint32_t COPY_OFFSET = 0x100, COPY_MAGIC = 0x59504F43;
+
+static TickCount CopyEngineRun(uint32_t op)
+{
+  const uint32_t dst = m_copy_regs[0] & CPU::PHYSICAL_MEMORY_ADDRESS_MASK,
+                 src = m_copy_regs[1] & CPU::PHYSICAL_MEMORY_ADDRESS_MASK;
+  const uint32_t len = m_copy_regs[2] & ~3u;
+  if ((op != 1 && op != 2) || !len || dst + len > g_ram_size || src + len > g_ram_size || dst + len < dst ||
+      src + len < src)
+    return 0;
+  for (uint32_t page = dst / HOST_PAGE_SIZE; page <= (dst + len - 1) / HOST_PAGE_SIZE; page++)
+    if (m_ram_code_bits[page])
+      CPU::CodeCache::InvalidateBlocksWithPageIndex(page);
+  if (op == 2)
+    for (uint32_t page = src / HOST_PAGE_SIZE; page <= (src + len - 1) / HOST_PAGE_SIZE; page++)
+      if (m_ram_code_bits[page])
+        CPU::CodeCache::InvalidateBlocksWithPageIndex(page);
+  if (op == 1)
+    std::memmove(&g_ram[dst], &g_ram[src], len);
+  else
+    for (uint32_t i = 0; i < len; i += 4)
+    {
+      uint32_t a, b;
+      std::memcpy(&a, &g_ram[dst + i], 4);
+      std::memcpy(&b, &g_ram[src + i], 4);
+      std::memcpy(&g_ram[dst + i], &b, 4);
+      std::memcpy(&g_ram[src + i], &a, 4);
+    }
+  return static_cast<TickCount>(len / 16); // a word every 4 cycles: far less than the CPU's own loop
+}
+
 template<MemoryAccessType type, MemoryAccessSize size>
 static TickCount DoEXP2Access(uint32_t offset, uint32_t& value)
 {
+  if (offset >= COPY_OFFSET && offset < COPY_OFFSET + 0x10 && size == MemoryAccessSize::Word)
+  {
+    const uint32_t reg = (offset - COPY_OFFSET) / 4;
+    if constexpr (type == MemoryAccessType::Read)
+    {
+      value = reg == 3 ? COPY_MAGIC : m_copy_regs[reg];
+      return m_exp2_access_time[static_cast<uint32_t>(size)];
+    }
+    else
+    {
+      if (reg < 3)
+        m_copy_regs[reg] = value;
+      else
+        CPU::g_state.pending_ticks += CopyEngineRun(value);
+      return 0;
+    }
+  }
   if constexpr (type == MemoryAccessType::Read)
   {
     // rx/tx buffer empty
