# Copy this file to env.toml (git-ignored) and uncomment only what differs on your machine.
# Anything left out keeps its default from env.example.toml. Check it with: scripts/doctor.py

[paths]
# disks = "<YOUR LOCAL PATH HERE>"           # folder holding your disc images
# win_emulators = "<YOUR LOCAL PATH HERE>"   # Windows tools, seen from WSL
# win_masters = "<YOUR LOCAL PATH HERE>"     # your master copies of the discs and BIOS

[android]
# keystore = "<YOUR LOCAL PATH HERE>"        # the release keystore, kept outside the repo
# password_file = "<YOUR LOCAL PATH HERE>"   # the file holding its password

[api_keys]
# sotncoop_resend_key = "<YOUR RESEND SENDING KEY>"   # release builds only: enables F9's Send button
